@model List<VehiclePartsSystem.Web.Models.PartRequestViewModel>
@{ ViewData["Title"] = "Request a Part"; }
<div class="container my-4">
    <h2 class="fw-bold mb-4"><i class="bi bi-search me-2"></i>Request Unavailable Parts</h2>
    <div class="card mb-4 p-4">
        <h5 class="fw-bold mb-3">Submit a Part Request</h5>
        <form asp-action="SubmitPartRequest" method="post">
            <input type="hidden" name="customerId" value="@ViewBag.CustomerId" />
            <div class="row g-3">
                <div class="col-md-5"><label class="form-label">Part Name</label><input name="partName" class="form-control" placeholder="e.g. Brake Pad for Toyota Corolla 2018" required /></div>
                <div class="col-md-5"><label class="form-label">Description</label><input name="description" class="form-control" placeholder="Additional details..." /></div>
                <div class="col-md-2 d-flex align-items-end"><button type="submit" class="btn btn-warning w-100">Submit</button></div>
            </div>
        </form>
    </div>
    <h5 class="fw-bold mb-3">My Requests</h5>
    @if (!Model.Any()) { <div class="alert alert-info">No part requests yet.</div> }
    else
    {
        <div class="card">
            <div class="card-body p-0">
                <table class="table table-hover mb-0">
                    <thead><tr><th>Part Name</th><th>Description</th><th>Status</th><th>Date</th></tr></thead>
                    <tbody>
                        @foreach (var r in Model)
                        {
                            <tr>
                                <td class="fw-semibold">@r.PartName</td>
                                <td>@r.Description</td>
                                <td><span class="badge @(r.Status == "Fulfilled" ? "bg-success" : r.Status == "Rejected" ? "bg-danger" : "bg-warning text-dark")">@r.Status</span></td>
                                <td>@r.CreatedAt.ToString("MMM dd, yyyy")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
