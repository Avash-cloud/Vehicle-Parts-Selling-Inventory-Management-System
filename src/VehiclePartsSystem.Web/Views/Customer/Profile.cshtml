@model VehiclePartsSystem.Web.Models.CustomerViewModel
@{ ViewData["Title"] = "My Profile"; }
<div class="container my-4">
    <h2 class="fw-bold mb-4"><i class="bi bi-person me-2"></i>My Profile</h2>
    <div class="row g-4">
        <div class="col-md-5">
            <div class="card p-4">
                <div class="text-center mb-3"><i class="bi bi-person-circle display-3 text-secondary"></i></div>
                <h4 class="text-center fw-bold">@Model.FullName</h4>
                <hr />
                <p><i class="bi bi-envelope me-2 text-muted"></i>@Model.Email</p>
                <p><i class="bi bi-phone me-2 text-muted"></i>@Model.Phone</p>
                <p><i class="bi bi-geo-alt me-2 text-muted"></i>@Model.Address</p>
                <p><i class="bi bi-currency-dollar me-2 text-muted"></i>Total Spent: <strong>Rs. @Model.TotalSpent.ToString("N2")</strong></p>
                @if (Model.CreditBalance > 0)
                { <div class="alert alert-warning"><i class="bi bi-exclamation-triangle me-2"></i>Outstanding Credit: Rs. @Model.CreditBalance.ToString("N2")</div> }
            </div>
        </div>
        <div class="col-md-7">
            <div class="card p-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold mb-0"><i class="bi bi-car-front me-2"></i>My Vehicles</h5>
                    <a asp-action="AddVehicle" class="btn btn-sm btn-warning"><i class="bi bi-plus me-1"></i>Add Vehicle</a>
                </div>
                @if (!Model.Vehicles.Any()) { <p class="text-muted">No vehicles registered.</p> }
                @foreach (var v in Model.Vehicles)
                {
                    <div class="card mb-3 border-0 bg-light p-3">
                        <div class="row">
                            <div class="col-auto"><i class="bi bi-car-front display-5 text-secondary"></i></div>
                            <div class="col">
                                <h6 class="fw-bold mb-1">@v.VehicleNumber</h6>
                                <p class="mb-0">@v.Make @v.Model (@v.Year)</p>
                                <small class="text-muted">@v.FuelType | @v.Mileage km | Last service: @v.LastServiceDate.ToString("MMM dd, yyyy")</small>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
