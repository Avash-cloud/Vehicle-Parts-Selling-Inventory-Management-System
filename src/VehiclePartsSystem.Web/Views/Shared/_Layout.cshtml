<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Vehicle Parts System</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm">
        <div class="container">
            <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">
                <i class="bi bi-gear-fill text-warning me-2"></i>VehicleParts
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Home</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Parts">Parts</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Reviews">Reviews</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="About">About</a></li>

                    @if (User.IsInRole("Admin"))
                    {
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">Admin</a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" asp-controller="Admin" asp-action="Index"><i class="bi bi-speedometer2 me-2"></i>Dashboard</a></li>
                                <li><a class="dropdown-item" asp-controller="Admin" asp-action="Parts"><i class="bi bi-box me-2"></i>Parts</a></li>
                                <li><a class="dropdown-item" asp-controller="Admin" asp-action="Vendors"><i class="bi bi-truck me-2"></i>Vendors</a></li>
                                <li><a class="dropdown-item" asp-controller="Admin" asp-action="Staff"><i class="bi bi-people me-2"></i>Staff</a></li>
                                <li><a class="dropdown-item" asp-controller="Admin" asp-action="Customers"><i class="bi bi-person-lines-fill me-2"></i>Customers</a></li>
                                <li><a class="dropdown-item" asp-controller="Admin" asp-action="PurchaseInvoices"><i class="bi bi-receipt me-2"></i>Purchase Invoices</a></li>
                                <li><a class="dropdown-item" asp-controller="Admin" asp-action="FinancialReport"><i class="bi bi-bar-chart me-2"></i>Financial Reports</a></li>
                                <li><a class="dropdown-item" asp-controller="Admin" asp-action="Notifications"><i class="bi bi-bell me-2"></i>Notifications</a></li>
                            </ul>
                        </li>
                    }

                    @if (User.IsInRole("Staff"))
                    {
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">Staff</a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" asp-controller="Staff" asp-action="Index"><i class="bi bi-speedometer2 me-2"></i>Dashboard</a></li>
                                <li><a class="dropdown-item" asp-controller="Staff" asp-action="Customers"><i class="bi bi-people me-2"></i>Customers</a></li>
                                <li><a class="dropdown-item" asp-controller="Staff" asp-action="RegisterCustomer"><i class="bi bi-person-plus me-2"></i>Register Customer</a></li>
                                <li><a class="dropdown-item" asp-controller="Staff" asp-action="SalesInvoices"><i class="bi bi-receipt me-2"></i>Sales Invoices</a></li>
                                <li><a class="dropdown-item" asp-controller="Staff" asp-action="CreateSalesInvoice"><i class="bi bi-plus-circle me-2"></i>New Sale</a></li>
                                <li><a class="dropdown-item" asp-controller="Staff" asp-action="Reports"><i class="bi bi-bar-chart me-2"></i>Reports</a></li>
                                <li><a class="dropdown-item" asp-controller="Staff" asp-action="Appointments"><i class="bi bi-calendar me-2"></i>Appointments</a></li>
                                <li><a class="dropdown-item" asp-controller="Staff" asp-action="PartRequests"><i class="bi bi-list-check me-2"></i>Part Requests</a></li>
                            </ul>
                        </li>
                    }

                    @if (User.IsInRole("Customer"))
                    {
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">My Account</a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" asp-controller="Customer" asp-action="Dashboard"><i class="bi bi-house me-2"></i>Dashboard</a></li>
                                <li><a class="dropdown-item" asp-controller="Customer" asp-action="Profile"><i class="bi bi-person me-2"></i>Profile</a></li>
                                <li><a class="dropdown-item" asp-controller="Customer" asp-action="History"><i class="bi bi-clock-history me-2"></i>Purchase History</a></li>
                                <li><a class="dropdown-item" asp-controller="Customer" asp-action="Appointments"><i class="bi bi-calendar me-2"></i>Appointments</a></li>
                                <li><a class="dropdown-item" asp-controller="Customer" asp-action="AiPrediction"><i class="bi bi-robot me-2"></i>AI Prediction</a></li>
                                <li><a class="dropdown-item" asp-controller="Customer" asp-action="PartRequests"><i class="bi bi-search me-2"></i>Request Part</a></li>
                                <li><a class="dropdown-item" asp-controller="Customer" asp-action="Reviews"><i class="bi bi-star me-2"></i>Reviews</a></li>
                            </ul>
                        </li>
                    }
                </ul>
                <ul class="navbar-nav">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">
                                <i class="bi bi-person-circle me-1"></i>@User.Identity.Name
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li><a class="dropdown-item" asp-controller="Account" asp-action="Logout"><i class="bi bi-box-arrow-right me-2"></i>Logout</a></li>
                            </ul>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="Login">Login</a></li>
                        <li class="nav-item"><a class="nav-link btn btn-warning btn-sm text-dark ms-2 px-3" asp-controller="Account" asp-action="Register">Register</a></li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <main>
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show m-3" role="alert">
                <i class="bi bi-check-circle me-2"></i>@TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show m-3" role="alert">
                <i class="bi bi-exclamation-triangle me-2"></i>@TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @RenderBody()
    </main>

    <footer class="bg-dark text-light py-4 mt-5">
        <div class="container text-center">
            <p class="mb-1"><i class="bi bi-gear-fill text-warning me-2"></i><strong>Vehicle Parts & Service Center</strong></p>
            <p class="text-muted small mb-0">CS6004NT Application Development &copy; 2026 Group K</p>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
