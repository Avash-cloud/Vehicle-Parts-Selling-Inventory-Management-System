@model List<VehiclePartsSystem.Web.Models.AppointmentViewModel>
@{ ViewData["Title"] = "Appointments"; }
<div class="container-fluid my-4">
    <h2 class="fw-bold mb-4"><i class="bi bi-calendar me-2"></i>Appointments</h2>
    <div class="card">
        <div class="card-body p-0">
            <table class="table table-hover mb-0">
                <thead><tr><th>Customer</th><th>Service</th><th>Date</th><th>Status</th><th>Notes</th><th>Update</th></tr></thead>
                <tbody>
                    @foreach (var a in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@a.CustomerName</td>
                            <td>@a.ServiceType</td>
                            <td>@a.AppointmentDate.ToString("MMM dd, yyyy HH:mm")</td>
                            <td><span class="badge @(a.Status == "Confirmed" ? "bg-success" : a.Status == "Pending" ? "bg-warning text-dark" : a.Status == "Completed" ? "bg-info" : "bg-secondary")">@a.Status</span></td>
                            <td>@a.Notes</td>
                            <td>
                                <form asp-action="UpdateAppointmentStatus" method="post" class="d-flex gap-1">
                                    <input type="hidden" name="id" value="@a.Id" />
                                    <select name="status" class="form-select form-select-sm" style="width:130px">
                                        <option>Pending</option><option>Confirmed</option><option>Completed</option><option>Cancelled</option>
                                    </select>
                                    <button type="submit" class="btn btn-sm btn-outline-primary">Update</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
