@model VehiclePartsSystem.Web.Models.CustomerViewModel
@{ ViewData["Title"] = "Customer Detail"; var history = ViewBag.History as List<VehiclePartsSystem.Web.Models.SalesInvoiceViewModel> ?? new(); }
<div class="container-fluid my-4">
    <a asp-action="Customers" class="btn btn-outline-secondary mb-3"><i class="bi bi-arrow-left me-2"></i>Back</a>
    <div class="row g-4">
        <div class="col-md-4">
            <div class="card p-4">
                <div class="text-center mb-3"><i class="bi bi-person-circle display-3 text-secondary"></i></div>
                <h4 class="text-center fw-bold">@Model.FullName</h4>
                <hr />
                <p><i class="bi bi-envelope me-2 text-muted"></i>@Model.Email</p>
                <p><i class="bi bi-phone me-2 text-muted"></i>@Model.Phone</p>
                <p><i class="bi bi-geo-alt me-2 text-muted"></i>@Model.Address</p>
                <p><strong>Total Spent:</strong> Rs. @Model.TotalSpent.ToString("N2")</p>
                @if (Model.CreditBalance > 0)
                { <div class="alert alert-warning p-2">Credit Balance: Rs. @Model.CreditBalance.ToString("N2")</div> }
            </div>
            <div class="card p-4 mt-3">
                <h6 class="fw-bold mb-3"><i class="bi bi-car-front me-2"></i>Vehicles</h6>
                @foreach (var v in Model.Vehicles)
                {
                    <div class="border rounded p-2 mb-2">
                        <strong>@v.VehicleNumber</strong> — @v.Make @v.Model (@v.Year)<br/>
                        <small class="text-muted">@v.FuelType | @v.Mileage km</small>
                    </div>
                }
            </div>
        </div>
        <div class="col-md-8">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="fw-bold">Purchase History</h5>
                <a asp-controller="Staff" asp-action="CreateSalesInvoice" class="btn btn-warning btn-sm"><i class="bi bi-plus-circle me-1"></i>New Sale</a>
            </div>
            <div class="card">
                <div class="card-body p-0">
                    <table class="table table-hover mb-0">
                        <thead><tr><th>Invoice #</th><th>Date</th><th>Total</th><th>Discount</th><th>Type</th><th>Paid</th><th>Email</th></tr></thead>
                        <tbody>
                            @foreach (var inv in history)
                            {
                                <tr>
                                    <td><code>@inv.InvoiceNumber</code></td>
                                    <td>@inv.InvoiceDate.ToString("MMM dd, yyyy")</td>
                                    <td>Rs. @inv.TotalAmount.ToString("N2")</td>
                                    <td>@(inv.DiscountAmount > 0 ? $"Rs. {inv.DiscountAmount:N2}" : "—")</td>
                                    <td><span class="badge @(inv.IsCreditSale ? "bg-warning text-dark" : "bg-info text-dark")">@(inv.IsCreditSale ? "Credit" : "Cash")</span></td>
                                    <td><span class="badge @(inv.IsPaid ? "bg-success" : "bg-danger")">@(inv.IsPaid ? "Paid" : "Unpaid")</span></td>
                                    <td>
                                        <form asp-action="EmailInvoice" method="post" class="d-inline">
                                            <input type="hidden" name="id" value="@inv.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-primary"><i class="bi bi-envelope"></i></button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
