@model List<VehiclePartsSystem.Web.Models.ReviewViewModel>
@{ ViewData["Title"] = "Customer Reviews"; }
<div class="container my-4">
    <h2 class="fw-bold mb-4"><i class="bi bi-star me-2"></i>Customer Reviews</h2>
    @if (!Model.Any())
    {
        <div class="alert alert-info">No reviews yet. Be the first to review!</div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var r in Model)
            {
                <div class="col-md-4">
                    <div class="card p-4 h-100">
                        <div class="star-rating mb-2">
                            @for (int i = 1; i <= 5; i++)
                            { <i class="bi @(i <= r.Rating ? "bi-star-fill" : "bi-star")"></i> }
                        </div>
                        <p class="fst-italic text-muted">"@r.Comment"</p>
                        <p class="fw-bold mb-0">— @r.CustomerName</p>
                        <small class="text-muted">@r.CreatedAt.ToString("MMM dd, yyyy")</small>
                    </div>
                </div>
            }
        </div>
    }
</div>
