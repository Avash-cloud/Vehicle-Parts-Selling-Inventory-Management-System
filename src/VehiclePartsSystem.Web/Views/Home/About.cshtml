@{ ViewData["Title"] = "About Us"; }
<div class="container my-5">
    <div class="row align-items-center">
        <div class="col-md-6">
            <h2 class="fw-bold mb-4">About Vehicle Parts & Service Center</h2>
            <p class="lead text-muted">We are a leading vehicle parts retailer and service center dedicated to providing genuine parts and exceptional service.</p>
            <p>Our state-of-the-art inventory management system ensures you always get the right part at the right time. With our AI-powered diagnostics, we help you stay ahead of potential vehicle issues.</p>
            <ul class="list-unstyled mt-4">
                <li class="mb-2"><i class="bi bi-check-circle-fill text-success me-2"></i>10,000+ genuine parts in stock</li>
                <li class="mb-2"><i class="bi bi-check-circle-fill text-success me-2"></i>Certified technicians</li>
                <li class="mb-2"><i class="bi bi-check-circle-fill text-success me-2"></i>AI-powered vehicle diagnostics</li>
                <li class="mb-2"><i class="bi bi-check-circle-fill text-success me-2"></i>Loyalty rewards program</li>
                <li class="mb-2"><i class="bi bi-check-circle-fill text-success me-2"></i>Online appointment booking</li>
            </ul>
        </div>
        <div class="col-md-6 text-center">
            <i class="bi bi-building display-1 text-secondary"></i>
            <div class="row mt-4 g-3">
                <div class="col-6"><div class="card p-3 text-center"><h3 class="text-warning fw-bold">500+</h3><p class="mb-0 text-muted">Happy Customers</p></div></div>
                <div class="col-6"><div class="card p-3 text-center"><h3 class="text-warning fw-bold">10K+</h3><p class="mb-0 text-muted">Parts Available</p></div></div>
                <div class="col-6"><div class="card p-3 text-center"><h3 class="text-warning fw-bold">5+</h3><p class="mb-0 text-muted">Years Experience</p></div></div>
                <div class="col-6"><div class="card p-3 text-center"><h3 class="text-warning fw-bold">24/7</h3><p class="mb-0 text-muted">Online Support</p></div></div>
            </div>
        </div>
    </div>
</div>
