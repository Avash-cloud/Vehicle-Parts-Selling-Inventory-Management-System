@model VehiclePartsSystem.Web.Models.FinancialReportViewModel
@{ ViewData["Title"] = "Financial Report"; }
<div class="container-fluid my-4">
    <h2 class="fw-bold mb-4"><i class="bi bi-bar-chart me-2"></i>Financial Report</h2>
    <div class="mb-4">
        <a asp-action="FinancialReport" asp-route-period="daily" class="btn @(ViewBag.Period == "daily" ? "btn-dark" : "btn-outline-dark") me-2">Daily</a>
        <a asp-action="FinancialReport" asp-route-period="monthly" class="btn @(ViewBag.Period == "monthly" ? "btn-dark" : "btn-outline-dark") me-2">Monthly</a>
        <a asp-action="FinancialReport" asp-route-period="yearly" class="btn @(ViewBag.Period == "yearly" ? "btn-dark" : "btn-outline-dark")">Yearly</a>
    </div>
    @if (Model != null)
    {
        <div class="row g-4 mb-4">
            <div class="col-md-3"><div class="card dashboard-card blue p-4"><h6 class="opacity-75">Total Revenue</h6><h3 class="fw-bold">Rs. @Model.TotalRevenue.ToString("N2")</h3></div></div>
            <div class="col-md-3"><div class="card dashboard-card red p-4"><h6 class="opacity-75">Total Cost</h6><h3 class="fw-bold">Rs. @Model.TotalCost.ToString("N2")</h3></div></div>
            <div class="col-md-3"><div class="card dashboard-card green p-4"><h6 class="opacity-75">Gross Profit</h6><h3 class="fw-bold">Rs. @Model.GrossProfit.ToString("N2")</h3></div></div>
            <div class="col-md-3"><div class="card dashboard-card orange p-4"><h6 class="opacity-75">Total Sales</h6><h3 class="fw-bold">@Model.TotalSalesCount</h3></div></div>
        </div>
        <div class="card">
            <div class="card-header bg-dark text-white"><h6 class="mb-0">Sales Breakdown — @Model.PeriodStart.ToString("MMM dd") to @Model.PeriodEnd.ToString("MMM dd, yyyy")</h6></div>
            <div class="card-body p-0">
                <table class="table table-hover mb-0">
                    <thead><tr><th>Date</th><th>Revenue</th><th>Sales Count</th></tr></thead>
                    <tbody>
                        @foreach (var d in Model.DailySales)
                        {
                            <tr>
                                <td>@d.Date.ToString("MMM dd, yyyy")</td>
                                <td>Rs. @d.Revenue.ToString("N2")</td>
                                <td>@d.SalesCount</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
