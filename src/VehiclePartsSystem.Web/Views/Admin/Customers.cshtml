@model List<VehiclePartsSystem.Web.Models.CustomerViewModel>
@{ ViewData["Title"] = "Customers"; }
<div class="container-fluid my-4">
    <h2 class="fw-bold mb-4"><i class="bi bi-person-lines-fill me-2"></i>Customers</h2>
    <form method="get" class="row g-2 mb-3">
        <div class="col-md-4"><input type="text" name="search" class="form-control" placeholder="Search by name, phone, email, ID..." value="@ViewBag.Search" /></div>
        <div class="col-md-2"><button type="submit" class="btn btn-dark w-100"><i class="bi bi-search me-1"></i>Search</button></div>
    </form>
    <div class="card">
        <div class="card-body p-0">
            <table class="table table-hover mb-0">
                <thead><tr><th>ID</th><th>Name</th><th>Email</th><th>Phone</th><th>Total Spent</th><th>Credit</th><th>Vehicles</th><th>Actions</th></tr></thead>
                <tbody>
                    @foreach (var c in Model)
                    {
                        <tr>
                            <td>#@c.Id</td>
                            <td class="fw-semibold">@c.FullName</td>
                            <td>@c.Email</td>
                            <td>@c.Phone</td>
                            <td>Rs. @c.TotalSpent.ToString("N2")</td>
                            <td>
                                @if (c.CreditBalance > 0)
                                { <span class="badge bg-danger">Rs. @c.CreditBalance.ToString("N2")</span> }
                                else { <span class="badge bg-success">Clear</span> }
                            </td>
                            <td>@c.Vehicles.Count</td>
                            <td><a asp-action="CustomerDetail" asp-route-id="@c.Id" class="btn btn-sm btn-outline-primary"><i class="bi bi-eye"></i></a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
