@{ ViewData["Title"] = "Create Purchase Invoice";
   var vendors = ViewBag.Vendors as List<VehiclePartsSystem.Web.Models.VendorViewModel> ?? new();
   var parts = ViewBag.Parts as List<VehiclePartsSystem.Web.Models.PartViewModel> ?? new(); }
<div class="container my-4">
    <h2 class="fw-bold mb-4"><i class="bi bi-receipt me-2"></i>Create Purchase Invoice</h2>
    <div class="card shadow">
        <div class="card-body p-4">
            <form asp-action="CreatePurchaseInvoice" method="post" id="purchaseForm">
                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Vendor</label>
                        <select name="vendorId" class="form-select" required>
                            <option value="">Select Vendor</option>
                            @foreach (var v in vendors) { <option value="@v.Id">@v.Name</option> }
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Notes</label>
                        <input name="notes" class="form-control" placeholder="Optional notes" />
                    </div>
                </div>
                <h6 class="fw-bold mb-3">Items</h6>
                <div id="items">
                    <div class="row g-2 mb-2 item-row">
                        <div class="col-md-5">
                            <select name="partIds" class="form-select" required>
                                <option value="">Select Part</option>
                                @foreach (var p in parts) { <option value="@p.Id">@p.Name (@p.PartNumber)</option> }
                            </select>
                        </div>
                        <div class="col-md-3"><input name="quantities" type="number" class="form-control" placeholder="Qty" min="1" required /></div>
                        <div class="col-md-3"><input name="unitCosts" type="number" step="0.01" class="form-control" placeholder="Unit Cost" required /></div>
                        <div class="col-md-1"><button type="button" class="btn btn-outline-danger btn-sm" onclick="removeRow(this)"><i class="bi bi-trash"></i></button></div>
                    </div>
                </div>
                <button type="button" class="btn btn-outline-secondary btn-sm mt-2" onclick="addRow()"><i class="bi bi-plus me-1"></i>Add Item</button>
                <div class="mt-4 d-flex gap-2">
                    <button type="submit" class="btn btn-warning px-4"><i class="bi bi-check-circle me-2"></i>Create Invoice</button>
                    <a asp-action="PurchaseInvoices" class="btn btn-outline-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>
@section Scripts {
<script>
function addRow() {
    const row = document.querySelector('.item-row').cloneNode(true);
    row.querySelectorAll('input').forEach(i => i.value = '');
    document.getElementById('items').appendChild(row);
}
function removeRow(btn) {
    const rows = document.querySelectorAll('.item-row');
    if (rows.length > 1) btn.closest('.item-row').remove();
}
</script>
}
