@model List<VehiclePartsSystem.Web.Models.PurchaseInvoiceViewModel>
@{ ViewData["Title"] = "Purchase Invoices"; }
<div class="container-fluid my-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold"><i class="bi bi-receipt me-2"></i>Purchase Invoices</h2>
        <a asp-action="CreatePurchaseInvoice" class="btn btn-warning"><i class="bi bi-plus-circle me-2"></i>New Purchase Invoice</a>
    </div>
    <div class="card">
        <div class="card-body p-0">
            <table class="table table-hover mb-0">
                <thead><tr><th>Invoice #</th><th>Vendor</th><th>Total</th><th>Status</th><th>Date</th></tr></thead>
                <tbody>
                    @foreach (var inv in Model)
                    {
                        <tr>
                            <td><code>@inv.InvoiceNumber</code></td>
                            <td>@inv.VendorName</td>
                            <td>Rs. @inv.TotalAmount.ToString("N2")</td>
                            <td><span class="badge @(inv.PaymentStatus == "Paid" ? "bg-success" : "bg-warning text-dark")">@inv.PaymentStatus</span></td>
                            <td>@inv.InvoiceDate.ToString("MMM dd, yyyy")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
